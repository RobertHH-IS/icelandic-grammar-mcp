{
  "name": "icelandic-grammar-mcp",
  "version": "1.0.0",
  "description": "Unofficial MCP server for Miðeind's Málfríður Icelandic grammar API",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "check": "node --check server/index.js && node --check .codex/skills/malfridur-api/scripts/check.mjs",
