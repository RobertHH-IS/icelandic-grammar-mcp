    "zod": "^4.4.3"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RobertHH-IS/icelandic-grammar-mcp.git"
  }
